# API Configuration
# Set to 'demo' to use mock data (no backend required)
# Set to your backend URL for production (e.g., https://api.yourdomain.com)
VITE_API_URL=demo

# Demo Mode (true = use mock data, false = use real backend)
VITE_DEMO_MODE=true

# Site Configuration
VITE_SITE_NAME=Nordhessen Automobile
VITE_SITE_URL=https://your-site.netlify.app

# Anfragen API
VITE_ANFRAGEN_API_URL=https://<backend-url>/api/anfragen

# Supabase - Add your credentials here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
