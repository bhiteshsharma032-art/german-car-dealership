{
  "name": "car-dealership-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Car dealership website - Nordhessen Automobile",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build:frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "cd frontend && npm install && npm run build",
    "vercel-build": "cd frontend && npm install --include=dev --legacy-peer-deps && npx --yes vite@5 build",
    "install:all": "npm install && npm install --workspaces"
  },
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "dependencies": {
    "axios": "^1.13.6",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.13",
    "@supabase/supabase-js": "^2.42.0",
    "uuid": "^13.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.37",
    "@types/xml2js": "^0.4.14",
    "concurrently": "^8.2.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
